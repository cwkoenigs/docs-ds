{
  "$schema": "https://json.schemastore.org/tsconfig",
  // Inlined from @docusaurus/tsconfig 3.10.2 minus `baseUrl`, which TypeScript 7 removed.
  "compilerOptions": {
    "allowJs": true,
    "esModuleInterop": true,
    "jsx": "preserve",
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "moduleResolution": "bundler",
    "module": "esnext",
    "noEmit": true,
    "resolveJsonModule": true,
    "paths": {
      "@site/*": ["./*"]
    },
    "skipLibCheck": true,
    "types": ["node", "react"]
  },
  "include": ["docusaurus.config.ts", "sidebars.ts", "src/**/*"],
  "exclude": ["node_modules", "build", ".docusaurus"]
}
