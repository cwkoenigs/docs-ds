{
  "name": "docs-ds",
  "version": "0.1.0",
  "private": true,
  "description": "Docs shell: the Docusaurus renderer behind `ds docs` and the team portal",
  "scripts": {
    "theme": "node scripts/build-theme.mjs",
    "check:theme": "node scripts/check-theme.mjs",
    "prestart": "npm run theme",
    "start": "docusaurus start --port 3333 --no-open",
    "prebuild": "npm run theme",
    "build": "docusaurus build",
    "serve": "docusaurus serve --port 3333 --no-open",
    "clear": "docusaurus clear",
    "typecheck": "tsc --noEmit",
    "check:build": "node scripts/check-build.mjs",
    "validate": "npm run check:theme && npm run typecheck && npm run build && npm run check:build"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/faster": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@docusaurus/theme-common": "3.10.2",
    "@easyops-cn/docusaurus-search-local": "0.55.3",
    "@mdx-js/react": "^3.1.0",
    "clsx": "^2.1.1",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "@types/node": "^26.0.0",
    "@types/react": "^19.0.0",
    "typescript": "~7.0.2"
  },
  "engines": {
    "node": ">=26.0"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome versions",
      "last 3 firefox versions",
      "last 3 safari versions"
    ]
  }
}
